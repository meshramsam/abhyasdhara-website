---
import Brand from '../components/Brand.astro';
import Icon from '../components/Icon.astro';
import '../styles/global.css';

const store = 'https://play.google.com/store/apps/details?id=sam.sanjanaacademy.education';
const exams = [
  { number: '०१', name: 'पोलीस भरती', icon: 'shield', text: 'ज्ञानाला वेगाची जोड. गणित, बुद्धिमत्ता आणि सामान्यज्ञानाचा सराव.', tags: 'गणित · बुद्धिमत्ता · मराठी' },
  { number: '०२', name: 'एमपीएससी', icon: 'building', text: 'विषय समजून तयारी करा. प्रश्नांच्या माध्यमातून अभ्यासाला योग्य दिशा.', tags: 'इतिहास · भूगोल · सामान्यज्ञान' },
  { number: '०३', name: 'वनरक्षक भरती', icon: 'leaf', text: 'तयारीतलं सातत्य जपा. विषयनिहाय चाचण्यांतून पक्का करा अभ्यास.', tags: 'विज्ञान · गणित · मराठी' },
  { number: '०४', name: 'एसआरपीएफ', icon: 'star', text: 'प्रत्येक सरावातून पुढे जा. अचूकता आणि वेळेचे नियोजन सुधारा.', tags: 'सराव · अचूकता · सातत्य' },
];
const faq = [
  ['अभ्यासधारा ॲप कोणासाठी आहे?', 'महाराष्ट्रातील पोलीस भरती, एमपीएससी, वनरक्षक भरती, एसआरपीएफ आणि इतर शासकीय स्पर्धा परीक्षांची तयारी करणाऱ्या विद्यार्थ्यांसाठी अभ्यासधारा आहे.'],
  ['ॲपमध्ये कोणत्या प्रकारचा सराव करता येतो?', 'दैनिक सराव, आठवड्याच्या सराव परीक्षा, विषयनिहाय चाचण्या, मागील वर्षांच्या प्रश्नपत्रिका, मराठी व्याकरण आणि जलद गणित यांसाठी ॲप पाहा. उपलब्ध चाचण्या आणि विभागांची अद्ययावत माहिती ॲपमध्ये तपासा.'],
  ['सरावासाठी शुल्क आहे का?', 'मोफत आणि प्रीमियम पर्यायांची उपलब्धता, चाचण्यांचे शुल्क आणि त्यांचा समावेश यांची अद्ययावत माहिती ॲपमध्ये तपासा. येथे कोणतीही सशुल्क नोंदणी किंवा व्यवहार होत नाही.'],
  ['ॲप कसे डाउनलोड करायचे?', 'या पानावरील “ॲप डाउनलोड करा” बटण तुम्हाला गूगल प्लेवरील अभ्यासधारा ॲपच्या पानावर घेऊन जाईल. तुमच्या अँड्रॉइड फोनवरून तिथे ॲप इन्स्टॉल करता येईल.'],
];
const schema = { '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'अभ्यासधारा अकॅडमी', alternateName: 'AbhyasDhara Academy', operatingSystem: 'Android', applicationCategory: 'EducationalApplication', inLanguage: 'mr', url: 'https://abhyasdhara.in', installUrl: store, description: 'महाराष्ट्रातील स्पर्धा परीक्षांसाठी सराव आणि शैक्षणिक तयारीचे ॲप.' };
---
<!doctype html>
<html lang="mr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f8f7ef" />
    <title>अभ्यासधारा अकॅडमी — तयारीला दिशा. अभ्यासाला धार.</title>
    <meta name="description" content="पोलीस भरती, एमपीएससी, वनरक्षक आणि एसआरपीएफ तयारीसाठी अभ्यासधारा. दैनिक सराव, सविस्तर उत्तरे, मराठी व्याकरण आणि मागील वर्षांच्या प्रश्नपत्रिका. ॲप जाणून घ्या." />
    <link rel="canonical" href="https://abhyasdhara.in/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/sans-devanagari.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/serif-devanagari.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="mr_IN" />
    <meta property="og:site_name" content="अभ्यासधारा अकॅडमी" />
    <meta property="og:title" content="तयारीला दिशा. अभ्यासाला धार." />
    <meta property="og:description" content="महाराष्ट्राच्या स्पर्धा परीक्षांसाठी रोजचा सराव आणि समजून शिकण्याची साथ. अभ्यासधारा अकॅडमी." />
    <meta property="og:url" content="https://abhyasdhara.in/" />
    <meta property="og:image" content="https://abhyasdhara.in/social-card.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="अभ्यासधारा अकॅडमी — तयारीला दिशा. अभ्यासाला धार." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="अभ्यासधारा अकॅडमी — अभ्यासाला धार." />
    <meta name="twitter:description" content="महाराष्ट्रातील स्पर्धा परीक्षांसाठी रोजच्या सरावाची साथ." />
    <meta name="twitter:image" content="https://abhyasdhara.in/social-card.png" />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <script is:inline>
      try { const t = localStorage.getItem('abhyasdhara-theme'); if(t === 'dark' || t === 'light') document.documentElement.dataset.theme = t; } catch {}
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">मुख्य मजकुराकडे जा</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a href="#" class="brand-link" aria-label="अभ्यासधारा अकॅडमी — मुख्यपृष्ठ"><Brand /></a>
        <nav class="desktop-nav" aria-label="मुख्य नेव्हिगेशन">
          <a href="#exams">परीक्षांची तयारी</a><a href="#practice">सरावाचा अनुभव</a><a href="#approach">अभ्यासाची वाट</a>
        </nav>
        <div class="header-actions">
          <button class="theme-button icon-button" aria-label="गडद रंगसंगती वापरा" title="रंगसंगती बदला" hidden><Icon name="moon" class="moon-icon"/><Icon name="sun" class="sun-icon"/></button>
          <a href={store} class="header-download">ॲप डाउनलोड करा<Icon name="diagonal" size={18}/></a>
          <details class="mobile-menu">
            <summary aria-label="नेव्हिगेशन मेनू"><span></span><span></span></summary>
            <nav aria-label="मोबाइल नेव्हिगेशन"><a href="#exams">परीक्षांची तयारी<Icon name="arrow"/></a><a href="#practice">सरावाचा अनुभव<Icon name="arrow"/></a><a href="#approach">अभ्यासाची वाट<Icon name="arrow"/></a><a href="#questions">तुमचे प्रश्न<Icon name="arrow"/></a></nav>
          </details>
        </div>
      </div>
    </header>

    <main id="main">
      <section class="hero shell" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow"><Icon name="spark" class="little-spark" size={24}/> महाराष्ट्राच्या स्पर्धा परीक्षांसाठी</p>
          <h1 id="hero-title">तयारीला दिशा.<br/>अभ्यासाला <span class="ink-word">धार.<svg viewBox="0 0 185 22" fill="none" aria-hidden="true"><path d="M3 14C47 1 111 1 180 9M15 20c47-10 109-12 157-9" stroke="currentColor" stroke-width="3" stroke-linecap="round"/></svg></span></h1>
          <p class="hero-description">स्वप्न वर्दीचं असो, की अधिकारी होण्याचं.<br class="wide-break"/> रोजचा सराव, सविस्तर उत्तरे आणि समजून शिकण्याची साथ — आता तुमच्या हातात.</p>
          <div class="hero-actions"><a href={store} class="button button-primary"><Icon name="play" size={21}/><span>ॲप डाउनलोड करा<small>गूगल प्लेवर मिळवा</small></span><Icon name="diagonal" size={22}/></a><a href="#practice" class="text-link">सराव अनुभवून पाहा<Icon name="arrow" size={21}/></a></div>
          <div class="hero-assurance"><span><Icon name="check" size={16}/>मराठीतून तयारी</span><span><Icon name="check" size={16}/>आपल्या गतीने सराव</span></div>
        </div>
        <figure class="hero-art">
          <div class="orbit orbit-outer" aria-hidden="true"></div><div class="orbit orbit-inner" aria-hidden="true"></div>
          <span class="orbit-dot" aria-hidden="true"></span>
          <div class="concept-note"><Icon name="spark" class="note-star" size={34}/> मोठ्या स्वप्नांची<br/><strong>सुरुवात, रोज थोडी.</strong><svg viewBox="0 0 80 45" fill="none" aria-hidden="true"><path d="M3 5c10 30 38 31 64 17m-11-5 13 3-4 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
          <div class="phone" aria-hidden="true">
            <div class="phone-camera"></div>
            <div class="phone-screen">
              <div class="phone-top"><Brand compact/><span class="phone-avatar">अ</span></div>
              <div class="phone-greeting"><span>नवं शिकण्याची नवी संधी</span><strong>आज थोडं<br/>पुढे जाऊया.</strong><Icon name="spark" class="greeting-sun" size={46}/></div>
              <div class="phone-test"><div class="phone-test-top"><span>दैनिक सराव</span><Icon name="bolt" size={20}/></div><strong>छोटा सराव.<br/>पक्की तयारी.</strong><div class="phone-test-bottom"><span>गणित + बुद्धिमत्ता</span><span>२० प्रश्न</span></div></div>
              <p class="phone-section-title">तुमचा अभ्यास, तुमच्या गतीने</p>
              <div class="phone-subject"><span class="subject-symbol">अ</span><span>मराठी व्याकरण<small>भाषेवर पकड मिळवा</small></span><span class="subject-line"></span></div>
              <div class="phone-subject"><span class="subject-symbol symbol-orange">%</span><span>जलद गणित<small>वेग आणि अचूकतेचा सराव</small></span><span class="subject-line"></span></div>
              <div class="phone-tip"><Icon name="book" size={19}/><span>प्रत्येक प्रश्नातून काहीतरी नवं.</span></div>
            </div>
          </div>
          <div class="learning-slip"><span class="slip-icon"><Icon name="book" size={27}/></span><span>फक्त उत्तर नाही.<strong>समजून घेण्याची सवय.</strong></span><span class="slip-plus" aria-hidden="true">+४</span></div>
          <figcaption>संकल्पचित्र · प्रत्यक्ष ॲपची रचना वेगळी असू शकते.</figcaption>
        </figure>
        <div class="hero-bottom"><span>आजचा सराव. उद्याचा आत्मविश्वास.</span><a href="#exams" aria-label="पुढे पाहा — परीक्षांची तयारी">पुढे पाहा<Icon name="down" size={18}/></a></div>
      </section>

      <section id="exams" class="exam-section section-space" aria-labelledby="exam-title">
        <div class="shell">
          <div class="section-heading exam-heading"><div><p class="eyebrow"><span class="section-index">०१ /</span> ध्येय तुमचं. साथ आमची.</p><h2 id="exam-title">वेगवेगळ्या परीक्षा.<br/><span>तयारीची एकच धारा.</span></h2></div><p>तुमचं ध्येय निवडा. विषय समजून घ्या.<br/>आणि रोजच्या सरावातून पुढे जात राहा.</p></div>
          <div class="exam-grid">{exams.map(exam => <article class="exam-card"><div class="exam-card-top"><Icon name={exam.icon} size={32}/><span>{exam.number}</span></div><h3>{exam.name}</h3><p>{exam.text}</p><span class="exam-tags">{exam.tags}</span></article>)}</div>
          <div class="exam-footnote"><span class="tiny-square" aria-hidden="true"></span><p>इतर शासकीय स्पर्धा परीक्षांच्या तयारीसाठीही उपयुक्त विषयांचा सराव.</p><a href={store}>ॲपमध्ये जाणून घ्या<Icon name="diagonal" size={17}/></a></div>
        </div>
      </section>

      <section id="practice" class="practice-section section-space shell" aria-labelledby="practice-title">
        <div class="section-heading"><div><p class="eyebrow"><span class="section-index">०२ /</span> पाठांतरापलीकडे, समजून शिकण्याकडे</p><h2 id="practice-title">उत्तर जाणून घ्या.<br/>कारणही <span class="serif-emphasis">समजून घ्या.</span></h2></div><p>प्रत्येक प्रश्न म्हणजे शिकण्याची संधी.<br/>एक उत्तर. सविस्तर स्पष्टीकरण.<br/>आणि आणखी चार महत्त्वाचे मुद्दे.</p></div>
        <div class="practice-layout">
          <div class="question-card">
            <div class="question-top"><span><span class="status-dot" aria-hidden="true"></span> इथेच सराव करून पाहा</span><span>गणित</span></div>
            <fieldset class="question-fieldset"><legend><span class="question-number">नमुना प्रश्न / ०१</span><span class="question-text">२४० चे २५%<br/>म्हणजे किती?</span></legend><p class="question-hint" id="question-hint">योग्य पर्याय निवडा.</p><div class="answer-grid">{[{ value:'40',label:'४०',letter:'अ' },{ value:'50',label:'५०',letter:'ब' },{ value:'60',label:'६०',letter:'क' },{ value:'80',label:'८०',letter:'ड' }].map(option => <label class="answer-option"><input type="radio" name="sample-answer" value={option.value} aria-describedby="question-hint"/><span class="answer-letter">{option.letter}</span><span>{option.label}</span><span class="answer-feedback" aria-hidden="true"></span></label>)}</div></fieldset>
            <p class="answer-status" role="status" aria-live="polite"></p>
            <details class="solution"><summary>उत्तर आणि स्पष्टीकरण पाहा<Icon name="plus" size={20}/></summary><div class="solution-body"><strong>योग्य उत्तर : ६०</strong><p>२५% म्हणजे एक चतुर्थांश.<br/>म्हणून २४० ÷ ४ = ६०.</p></div></details>
            <p class="demo-caption">हा नमुना सराव आहे. पूर्ण चाचण्यांसाठी ॲप पाहा.</p>
          </div>
          <div class="learning-content"><p class="small-label">एका प्रश्नातून, आणखी चार गोष्टी.</p><h3>उत्तरापलीकडे<br/>शिकण्याची <span>सवय.</span></h3><div class="learning-points"><div><span>०१</span><p><strong>१०% = एक दशांश</strong>कोणत्याही संख्येला १० ने भागा.</p></div><div><span>०२</span><p><strong>२०% = एक पंचमांश</strong>संख्येला ५ ने भागा.</p></div><div><span>०३</span><p><strong>५०% = अर्धा</strong>संख्येला २ ने भागा.</p></div><div><span>०४</span><p><strong>७५% = तीन चतुर्थांश</strong>चौथ्या भागाला ३ ने गुणा.</p></div></div><div class="learning-callout"><Icon name="bolt" size={22}/><p>पद्धत समजली की, पुढचा प्रश्न<br/><strong>सोडवण्याचा आत्मविश्वास वाढतो.</strong></p></div></div>
        </div>
      </section>

      <section id="approach" class="approach-section section-space" aria-labelledby="approach-title"><div class="shell">
        <div class="section-heading"><div><p class="eyebrow"><span class="section-index">०३ /</span> तयारीला द्या सातत्याची जोड</p><h2 id="approach-title">रोज थोडं.<br/><span class="serif-emphasis">पण समजून, पुढे.</span></h2></div><p>अभ्यासाचं ओझं नाही, अभ्यासाची सवय.<br/>तुमच्या वेळेनुसार, तुमच्या गतीने.</p></div>
        <div class="approach-grid">
          <article class="routine-card"><div class="card-eyebrow"><Icon name="clock" size={22}/><span>नियमित सराव</span></div><h3>आजचा छोटा सराव.<br/>तयारीची पक्की सवय.</h3><p>दैनिक चाचण्यांतून उजळणी करा. आठवड्याच्या सराव परीक्षेतून तुमची तयारी तपासा.</p><div class="week-illustration" role="img" aria-label="नियमित सरावाच्या सवयीचे संकल्पचित्र"><div class="week-label"><span>सातत्याची अभ्यासवाट</span><Icon name="arrow" size={18}/></div><div class="week-days">{['सो','मं','बु','गु','शु','श','र'].map((day, index) => <div class:list={['week-day', { 'week-day-filled': index < 5 }]}><span>{day}</span><span class="day-mark">{index < 5 ? <Icon name="check" size={17}/> : <span class="day-dot"></span>}</span></div>)}</div><span class="illustration-label">सवयीचे संकल्पचित्र</span></div></article>
          <article class="skill-card"><span class="skill-symbol" aria-hidden="true">अ<span>आ</span></span><div><p class="small-label">भाषेची भक्कम पायाभरणी</p><h3>मराठीवर पकड.<br/>गुणांना बळ.</h3><p>व्याकरणाचे नियम समजून घ्या आणि विषयनिहाय सरावातून पक्के करा.</p></div><span class="skill-footer">शब्द · नियम · उपयोग</span></article>
          <article class="speed-card"><div class="speed-art" aria-hidden="true"><span>२५<span>%</span></span><svg viewBox="0 0 160 50" fill="none"><path d="M5 40c25 0 33-31 57-31s24 32 50 32c19 0 26-24 43-24m-10-5 11 4-6 10" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></div><div><p class="small-label">वेगासोबत अचूकताही</p><h3>गणिताला गती.<br/>विचारांना चालना.</h3><p>जलद गणित आणि बुद्धिमत्तेच्या सरावातून प्रश्न सोडवण्याची पद्धत सुधारा.</p></div><span class="skill-footer">गणित · तर्क · आव्हाने</span></article>
        </div>
